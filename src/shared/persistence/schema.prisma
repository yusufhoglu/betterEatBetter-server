// Ozellik modullerinin semalari ayri promptlarda eklenecek. pgvector extension
// RAG embedding / benzer yemek aramasi icin kullanilacak (bkz backend-architecture.md SS5).
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Nullable: a user who only ever signed in with Google has no password.
  // Google's `sub` claim — stable per Google account, set when a Google
  // sign-in first links to this user (either a brand-new user or an existing
  // email+password account matched by verified email; see identity-rule.md).
  passwordHash String?
  googleSub    String?  @unique
  name         String?
  username     String?  @unique
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens          RefreshToken[]
  userProfile            UserProfile?
  plan                   Plan?
  unitPreference         UnitPreference?
  notificationPreference NotificationPreference?
  favoriteRecipes        FavoriteRecipe[]
  savedMeals             SavedMeal[]
  subscriptions          Subscription[]
  socialPosts            SocialPost[]
  socialComments         SocialComment[]
  socialPostLikes        SocialPostLike[]
  socialCommentLikes     SocialCommentLike[]

  @@map("users")
}

// onboarding-plan module: survey answers collected once at CompleteOnboarding time.
// Entirely separate from User — related only via userId FK, no fields added to User.
model UserProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg        Float
  targetWeightKg  Float?
  initialWeightKg Float
  heightCm        Float
  age             Int
  gender          String
  workoutsPerWeek Int
  goal            String // 'lose' | 'maintain' | 'gain'
  weeklyPaceKg    Float
  createdAt       DateTime @default(now())

  @@map("user_profiles")
}

// onboarding-plan module: the single active plan per user (userId is unique — no
// plan history is kept this round, see onboarding-plan-rule.md).
model Plan {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalories Float
  proteinG      Float
  carbsG        Float
  fatG          Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("plans")
}

// Opaque, DB-stored token (not a JWT) — required for rotation + reuse detection.
// Only the hash is persisted so a DB leak alone can't be used to impersonate a user.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// food-recognition module: persists async photo recognition results.
// ONLY the photo flow writes here — barcode/text/search are synchronous and
// return results directly without persistent storage.
model FoodEntry {
  id         String   @id               // = mealPhotoId (deterministic job id)
  userId     String
  status     String                     // 'processing' | 'completed' | 'insufficient_data' | 'failed'
  resultJson Json?                      // Python RAG raw result (items, macros, needsUserAction)
  errorCode  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("food_entries")
}

// Pre-imported USDA FoodData Central data.
// Populated once via: npm run import:usda
// Full-text search uses Postgres GIN index on the name column.
model FoodCatalogItem {
  id              String @id @default(uuid())
  name            String
  caloriesPer100g Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float

  @@map("food_catalog_items")
}

model MealItem {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  mealType  String
  entries   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, mealType])
  @@map("meal_items")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@map("outbox_events")
}

model BodyMeasurement {
  id        String   @id @default(uuid())
  userId    String
  metric    String
  value     Float
  unit      String
  date      DateTime
  source    String
  createdAt DateTime @default(now())

  @@index([userId, metric, date])
  @@map("body_measurements")
}

model BodySilhouetteProfile {
  userId     String   @id
  neckCm     Float?
  shoulderCm Float?
  waistCm    Float?
  hipCm      Float?
  updatedAt  DateTime @updatedAt

  @@map("body_silhouette_profiles")
}

model MealLogReadModel {
  id       String   @id @default(uuid())
  userId   String
  date     DateTime @db.Date
  mealType String
  entries  Json
  loggedAt DateTime @default(now())

  @@unique([userId, date, mealType])
  @@index([userId, date])
  @@map("meal_log_read_models")
}

model UnitPreference {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightUnit String   @default("kg")
  heightUnit String   @default("cm")
  energyUnit String   @default("kcal")
  waterUnit  String   @default("ml")
  updatedAt  DateTime @updatedAt

  @@map("unit_preferences")
}

model NotificationPreference {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterEnabled    Boolean  @default(true)
  breakfastEnabled Boolean  @default(true)
  breakfastTime    String   @default("08:30")
  lunchEnabled     Boolean  @default(true)
  lunchTime        String   @default("12:30")
  dinnerEnabled    Boolean  @default(true)
  dinnerTime       String   @default("19:30")
  waterReminders   Boolean  @default(true)
  streakSaver      Boolean  @default(true)
  weeklyReport     Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("notification_preferences")
}

// "Favorite Meals" — the user's bookmarked meals, incl. anything saved from
// the Social feed (with full macros + a re-signable photo reference).
// `prepTimeMinutes` is only set for hand-added recipes.
model FavoriteRecipe {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  imageUrl        String?
  emoji           String?
  kcal            Int
  prepTimeMinutes Int?
  proteinG        Int?
  carbsG          Int?
  fatG            Int?
  mealPhotoId      String?
  mealPhotoOwnerId String?
  createdAt       DateTime @default(now())

  @@unique([userId, mealPhotoId])
  @@index([userId, createdAt])
  @@map("favorite_recipes")
}

model SavedMeal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  imageUrl  String?
  emoji     String?
  kcal      Int
  proteinG  Int
  carbsG    Int?
  fatG      Int?
  // When saved from the Social feed: the source meal photo, re-signed on read.
  // `imageUrl` is derived from these when present.
  mealPhotoId      String?
  mealPhotoOwnerId String?
  createdAt DateTime @default(now())

  // A given Social meal photo is saved at most once per user (NULLs don't
  // collide, so manual saves are unaffected).
  @@unique([userId, mealPhotoId])
  @@index([userId, createdAt])
  @@map("saved_meals")
}

model Subscription {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  provider      String
  status        String
  expiresAt     DateTime?
  // Google Play purchaseToken (or, in future, an Apple originalTransactionId).
  // RTDN webhook notifications only carry this + productId, not our userId, so
  // it's the lookup key for reconciling async provider notifications.
  purchaseToken String?   @unique
  // Mirrors the mobile-facing Entitlement contract (see
  // subscription-backend-contract.md) — willRenew/inGracePeriod aren't
  // derivable from `status` alone (e.g. a canceled-but-unexpired
  // subscription is still `status: active` but `willRenew: false`).
  willRenew     Boolean   @default(false)
  inGracePeriod Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status, expiresAt])
  @@unique([userId, productId, provider])
  @@map("subscriptions")
}

// chatbot module: conversationId is client/trace-supplied (stays fixed for the
// whole chat, doubles as trace_id) — never server-generated per message.
model Conversation {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  messages  Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 'system'|'user'|'assistant'|'tool'
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// social module: a small reverse-chronological feed of meal photos the user
// already logged and chose to make public. `mealPhotoId` points at an existing
// R2 object at users/{authorId}/meals/{mealPhotoId}.jpg — the social module
// never stores image bytes, it mints a short-lived signed URL on read.
model SocialPost {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mealPhotoId String
  caption     String   @default("")
  edited      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Denormalized meal nutrition, so the feed can filter by calorie / macro
  // range at the DB level. Populated at share time from the recognised result
  // and re-synced when the author edits the logged meal. NULL = unknown.
  calories Int?
  proteinG Int?
  carbsG   Int?
  fatG     Int?

  comments SocialComment[]
  likes    SocialPostLike[]

  // A given meal photo is shared to the feed at most once.
  @@unique([authorId, mealPhotoId])
  @@index([createdAt])
  @@index([calories, createdAt])
  @@map("social_posts")
}

model SocialComment {
  id        String         @id @default(uuid())
  postId    String
  post      SocialPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  parentId  String?
  parent    SocialComment? @relation("SocialCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  replies SocialComment[]     @relation("SocialCommentReplies")
  likes   SocialCommentLike[]

  @@index([postId, createdAt])
  @@map("social_comments")
}

model SocialPostLike {
  postId    String
  userId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([postId, userId])
  @@map("social_post_likes")
}

model SocialCommentLike {
  commentId String
  userId    String
  comment   SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([commentId, userId])
  @@map("social_comment_likes")
}
