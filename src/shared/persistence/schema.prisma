// Ozellik modullerinin semalari ayri promptlarda eklenecek. pgvector extension
// RAG embedding / benzer yemek aramasi icin kullanilacak (bkz backend-architecture.md SS5).
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Nullable: a user who only ever signed in with Google has no password.
  // Google's `sub` claim — stable per Google account, set when a Google
  // sign-in first links to this user (either a brand-new user or an existing
  // email+password account matched by verified email; see identity-rule.md).
  passwordHash String?
  googleSub    String?  @unique
  name         String?
  username     String?  @unique
  bio          String?
  avatarUrl    String?
  // Set by a platform admin (admin module). A suspended user cannot start a
  // session; existing refresh tokens are revoked at suspension time.
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens          RefreshToken[]
  userProfile            UserProfile?
  plan                   Plan?
  unitPreference         UnitPreference?
  notificationPreference NotificationPreference?
  deviceTokens           DeviceToken[]
  favoriteRecipes        FavoriteRecipe[]
  savedMeals             SavedMeal[]
  savedRecipes           SavedRecipe[]
  subscriptions          Subscription[]
  socialPosts            SocialPost[]
  socialComments         SocialComment[]
  socialPostLikes        SocialPostLike[]
  socialCommentLikes     SocialCommentLike[]
  organizationMembers    OrganizationMember[]
  dietitianProfile       DietitianProfile?
  dietitianLinks         DietitianClientLink[]   @relation("LinkDietitian")
  clientLinks            DietitianClientLink[]   @relation("LinkClient")
  dataAccessLogsAbout    DataAccessLog[]
  threadParticipants     ThreadParticipant[]
  sentChatMessages       ChatMessage[]
  stepLogs               StepLog[]
  alertRuleSettings      AlertRuleSetting[]
  aiAssistantSettings    DietitianAiSettings?
  aiExamples             DietitianAiExample[]

  @@map("users")
}

// onboarding-plan module: survey answers collected once at CompleteOnboarding time.
// Entirely separate from User — related only via userId FK, no fields added to User.
model UserProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg        Float
  targetWeightKg  Float?
  initialWeightKg Float
  heightCm        Float
  age             Int
  gender          String
  workoutsPerWeek Int
  goal            String // 'lose' | 'maintain' | 'gain'
  weeklyPaceKg    Float
  // Current tape-measure circumferences (cm). Seeded at onboarding, then kept in
  // lockstep with the latest body_measurements row for the same metric (see
  // body-analytics/UpdateBodySilhouetteProfile). waist/neck/hip drive a US-Navy
  // body-fat estimate; without them the plan falls back to a Deurenberg
  // (BMI-based) estimate. shoulderCm is not used for body fat — it is kept for
  // the shoulder-to-waist ratio. See PlanCalculationService.
  waistCm         Float?
  neckCm          Float?
  hipCm           Float?
  shoulderCm      Float?
  createdAt       DateTime @default(now())

  @@map("user_profiles")
}

// onboarding-plan module: the single active plan per user (userId is unique — no
// plan history is kept this round, see onboarding-plan-rule.md).
model Plan {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalories    Float
  proteinG         Float
  carbsG           Float
  fatG             Float
  // Who set the current targets. 'dietitian' plans are owned by the client's
  // assigned dietitian (practice module) — see dietitian-platform-design.md.
  source           String   @default("self") // 'self' | 'dietitian'
  setByDietitianId String?
  // Daily water / step targets. NULL = automatic (derived from the profile,
  // see onboarding-plan/domain/ComputeActivityTargets); a number is an
  // explicit override (today only a dietitian sets one).
  waterTargetMl    Int?
  stepTarget       Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("plans")
}

// Opaque, DB-stored token (not a JWT) — required for rotation + reuse detection.
// Only the hash is persisted so a DB leak alone can't be used to impersonate a user.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// food-recognition module: persists async photo recognition results.
// ONLY the photo flow writes here — barcode/text/search are synchronous and
// return results directly without persistent storage.
model FoodEntry {
  id         String   @id // = mealPhotoId (deterministic job id)
  userId     String
  status     String // 'processing' | 'completed' | 'insufficient_data' | 'failed'
  resultJson Json? // Python RAG raw result (items, macros, needsUserAction)
  errorCode  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("food_entries")
}

enum NutritionBasis {
  PER_100G
  PER_SERVING
}

// Pre-imported food catalog: generic USDA FoodData Central items (basis=PER_100G,
// via: npm run import:usda) and branded/restaurant-chain items (basis=PER_SERVING,
// via: npm run import:branded — brand/category/servingLabel populated).
// Full-text search uses Postgres GIN index on the name column.
model FoodCatalogItem {
  id           String         @id @default(uuid())
  name         String
  brand        String?
  category     String?
  basis        NutritionBasis @default(PER_100G)
  servingLabel String?
  calories     Float
  proteinG     Float
  carbsG       Float
  fatG         Float

  @@map("food_catalog_items")
}

model MealItem {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  mealType  String
  entries   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, mealType])
  @@map("meal_items")
}

// water-logging module: one row per (user, day) — a running daily total,
// not an event log, since the client only ever shows/edits today's total
// (see mobile ApiHomeRepository.addWater/removeLastWater).
model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  amountMl  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("water_logs")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@map("outbox_events")
}

model BodyMeasurement {
  id        String   @id @default(uuid())
  userId    String
  metric    String
  value     Float
  unit      String
  date      DateTime
  source    String
  createdAt DateTime @default(now())

  @@index([userId, metric, date])
  @@map("body_measurements")
}

model MealLogReadModel {
  id       String   @id @default(uuid())
  userId   String
  date     DateTime @db.Date
  mealType String
  entries  Json
  loggedAt DateTime @default(now())

  @@unique([userId, date, mealType])
  @@index([userId, date])
  @@map("meal_log_read_models")
}

model UnitPreference {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightUnit String   @default("kg")
  heightUnit String   @default("cm")
  energyUnit String   @default("kcal")
  waterUnit  String   @default("ml")
  updatedAt  DateTime @updatedAt

  @@map("unit_preferences")
}

model NotificationPreference {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterEnabled    Boolean  @default(true)
  breakfastEnabled Boolean  @default(true)
  breakfastTime    String   @default("08:30")
  lunchEnabled     Boolean  @default(true)
  lunchTime        String   @default("12:30")
  dinnerEnabled    Boolean  @default(true)
  dinnerTime       String   @default("19:30")
  waterReminders   Boolean  @default(true)
  streakSaver      Boolean  @default(true)
  weeklyReport     Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("notification_preferences")
}

// notifications module: one row per (device, push token). `token` is the FCM
// registration token or APNs device token the mobile app obtained; `timezone`
// is the device's IANA zone, refreshed on every registration so the scheduled
// jobs can compare against the user's local wall-clock rather than server time.
// `locale` is the language the job-composed copy should be written in.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String // 'ios' | 'android'
  token      String   @unique
  timezone   String   @default("UTC")
  locale     String   @default("en") // 'en' | 'tr'
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

// "Favorite Meals" — the user's bookmarked meals, incl. anything saved from
// the Social feed (with full macros + a re-signable photo reference).
// `prepTimeMinutes` is only set for hand-added recipes.
model FavoriteRecipe {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  imageUrl         String?
  emoji            String?
  kcal             Int
  prepTimeMinutes  Int?
  proteinG         Int?
  carbsG           Int?
  fatG             Int?
  mealPhotoId      String?
  mealPhotoOwnerId String?
  createdAt        DateTime @default(now())

  @@unique([userId, mealPhotoId])
  @@index([userId, createdAt])
  @@map("favorite_recipes")
}

model SavedMeal {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  imageUrl         String?
  emoji            String?
  kcal             Int
  proteinG         Int
  carbsG           Int?
  fatG             Int?
  // When saved from the Social feed: the source meal photo, re-signed on read.
  // `imageUrl` is derived from these when present.
  mealPhotoId      String?
  mealPhotoOwnerId String?
  createdAt        DateTime @default(now())

  // A given Social meal photo is saved at most once per user (NULLs don't
  // collide, so manual saves are unaffected).
  @@unique([userId, mealPhotoId])
  @@index([userId, createdAt])
  @@map("saved_meals")
}

// A dietician-generated recipe the user chose to keep. Stores the full Recipe
// domain object (dietician module) — scalar fields as columns, `ingredients`
// (RecipeIngredient[]) and `steps` (string[]) as JSON. `mealPhotoId` /
// `mealPhotoOwnerId` point at an optional user-attached photo, re-signed on read
// exactly like SavedMeal. No dedupe — each save is a deliberate action.
model SavedRecipe {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  subtitle         String?
  timeMinutes      Int
  servings         Int
  calories         Int
  proteinGrams     Int
  carbsGrams       Int
  fatGrams         Int
  fiberGrams       Int?
  ingredients      Json
  steps            Json
  why              String?
  mealPhotoId      String?
  mealPhotoOwnerId String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@map("saved_recipes")
}

model Subscription {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  provider      String
  status        String
  expiresAt     DateTime?
  // Google Play purchaseToken (or, in future, an Apple originalTransactionId).
  // RTDN webhook notifications only carry this + productId, not our userId, so
  // it's the lookup key for reconciling async provider notifications.
  purchaseToken String?   @unique
  // Mirrors the mobile-facing Entitlement contract (see
  // subscription-backend-contract.md) — willRenew/inGracePeriod aren't
  // derivable from `status` alone (e.g. a canceled-but-unexpired
  // subscription is still `status: active` but `willRenew: false`).
  willRenew     Boolean   @default(false)
  inGracePeriod Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, productId, provider])
  @@index([userId, status, expiresAt])
  @@map("subscriptions")
}

// chatbot module: conversationId is client/trace-supplied (stays fixed for the
// whole chat, doubles as trace_id) — never server-generated per message.
model Conversation {
  id            String    @id @default(uuid())
  userId        String
  createdAt     DateTime  @default(now())
  // Denormalized max(messages.createdAt) — kept current on every appendMessage
  // so "list my conversations, newest first" is a single indexed query.
  // Null for a conversation that was materialized but never messaged.
  lastMessageAt DateTime?
  messages      Message[]

  @@index([userId])
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 'system'|'user'|'assistant'|'tool'
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// dietician module: a goal-oriented coaching conversation. conversationId is
// client/trace-supplied like Conversation. `digest` is a rolling structured
// summary (ConversationDigest) that stands in for messages trimmed out of the
// context window; `digestTurn` records the turnCount it was last rebuilt at.
model DieticianConversation {
  id            String             @id @default(uuid())
  userId        String
  createdAt     DateTime           @default(now())
  turnCount     Int                @default(0)
  digest        Json?
  digestTurn    Int                @default(0)
  // See Conversation.lastMessageAt — same denormalization, same purpose.
  lastMessageAt DateTime?
  messages      DieticianMessage[]

  @@index([userId])
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("dietician_conversations")
}

model DieticianMessage {
  id             String                @id @default(uuid())
  conversationId String
  conversation   DieticianConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 'system'|'user'|'assistant'|'tool'
  content        String
  origin         String                @default("live") // 'live' | 'proactive'
  // Set when the turn ran as a human dietitian's AI assistant (practice module).
  // The dietitian reviews only the messages stamped with their own id.
  dietitianId    String?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@index([dietitianId, createdAt])
  @@map("dietician_messages")
}

// social module: a small reverse-chronological feed of meal photos the user
// already logged and chose to make public. `mealPhotoId` points at an existing
// R2 object at users/{authorId}/meals/{mealPhotoId}.jpg — the social module
// never stores image bytes, it mints a short-lived signed URL on read.
model SocialPost {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mealPhotoId String
  caption     String   @default("")
  edited      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Denormalized meal nutrition, so the feed can filter by calorie / macro
  // range at the DB level. Populated at share time from the recognised result
  // and re-synced when the author edits the logged meal. NULL = unknown.
  calories Int?
  proteinG Int?
  carbsG   Int?
  fatG     Int?

  comments SocialComment[]
  likes    SocialPostLike[]

  // A given meal photo is shared to the feed at most once.
  @@unique([authorId, mealPhotoId])
  @@index([createdAt])
  @@index([calories, createdAt])
  @@map("social_posts")
}

model SocialComment {
  id        String         @id @default(uuid())
  postId    String
  post      SocialPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  parentId  String?
  parent    SocialComment? @relation("SocialCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  replies SocialComment[]     @relation("SocialCommentReplies")
  likes   SocialCommentLike[]

  @@index([postId, createdAt])
  @@map("social_comments")
}

model SocialPostLike {
  postId    String
  userId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([postId, userId])
  @@map("social_post_likes")
}

model SocialCommentLike {
  commentId String
  userId    String
  comment   SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([commentId, userId])
  @@map("social_comment_likes")
}

// ─── practice module (dietitian platform) ───────────────────────────────────
// See dietitian-platform-design.md. A solo dietitian is a one-member
// organization, so every client link hangs off an organization.

model Organization {
  id        String   @id @default(uuid())
  name      String
  kind      String // 'clinic' | 'solo'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         OrganizationMember[]
  activationCodes DietitianActivationCode[]
  clientLinks     DietitianClientLink[]

  @@map("organizations")
}

model OrganizationMember {
  organizationId String
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String // 'owner' | 'admin' | 'dietitian'
  status         String       @default("active") // 'active' | 'removed' | 'suspended' (by a platform admin)
  // Random per-membership key embedded in stateless client invite codes.
  // Rotating it invalidates every invite code issued before.
  inviteKey      String       @unique
  joinedAt       DateTime     @default(now())

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model DietitianProfile {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String?
  licenseNo        String?
  bio              String?
  specialties      String[] @default([])
  activationCodeId String?
  verifiedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("dietitian_profiles")
}

// Admin-generated (src/scripts/createActivationCode.ts). Only the hash is stored.
model DietitianActivationCode {
  id             String        @id @default(uuid())
  codeHash       String        @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgRole        String        @default("dietitian") // role granted inside organizationId
  note           String?
  maxUses        Int           @default(1)
  usedCount      Int           @default(0)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@map("dietitian_activation_codes")
}

model DietitianClientLink {
  id               String          @id @default(uuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dietitianId      String
  dietitian        User            @relation("LinkDietitian", fields: [dietitianId], references: [id], onDelete: Cascade)
  clientId         String
  client           User            @relation("LinkClient", fields: [clientId], references: [id], onDelete: Cascade)
  status           String // 'active' | 'ended'
  // Data the client currently shares; the client toggles these at will.
  consentScopes    String[]
  consentUpdatedAt DateTime        @default(now())
  startedAt        DateTime        @default(now())
  endedAt          DateTime?
  endedBy          String?
  notes            DietitianNote[]
  insight          ClientInsight?
  aiSetting        ClientAiSetting?

  @@index([dietitianId, status])
  @@index([organizationId, status])
  @@index([clientId, status])
  @@map("dietitian_client_links")
}

model DataAccessLog {
  id        String   @id @default(uuid())
  actorId   String
  subjectId String
  subject   User     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  scope     String
  resource  String
  createdAt DateTime @default(now())

  @@index([subjectId, createdAt(sort: Desc)])
  @@map("data_access_logs")
}

// Private to the dietitian side — never exposed to the client.
model DietitianNote {
  id        String              @id @default(uuid())
  linkId    String
  link      DietitianClientLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([linkId, createdAt(sort: Desc)])
  @@map("dietitian_notes")
}

// ─── messaging module (human ↔ human chat) ─────────────────────────────────

model Thread {
  id            String    @id @default(uuid())
  kind          String // 'dietitian_client'
  refId         String? // DietitianClientLink.id for kind='dietitian_client'
  readOnly      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?

  participants ThreadParticipant[]
  messages     ChatMessage[]

  @@index([refId])
  @@map("threads")
}

model ThreadParticipant {
  threadId   String
  userId     String
  thread     Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@id([threadId, userId])
  @@index([userId])
  @@map("thread_participants")
}

model ChatMessage {
  id              String    @id @default(uuid())
  threadId        String
  thread          Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  // Null once the sender deletes their account — the other side keeps history.
  senderId        String?
  sender          User?     @relation(fields: [senderId], references: [id], onDelete: SetNull)
  clientMessageId String
  type            String // 'text' | 'image' | 'meal_ref' | 'system'
  body            String?
  attachments     Json?
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  @@unique([threadId, clientMessageId])
  @@index([threadId, createdAt(sort: Desc)])
  @@map("chat_messages")
}

// ─── activity module (steps from Apple Health / Health Connect) ─────────────
// One row per (user, day): the device's daily total, re-sent (upserted) as the
// day progresses. Not an event log.
model StepLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  steps     Int
  source    String // 'apple_health' | 'health_connect' | 'manual'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("step_logs")
}

// ─── practice: alerts & adherence ───────────────────────────────────────────

// A dietitian's override of one alert rule (practice/domain/alertRules.ts).
// No row = the rule's defaults.
model AlertRuleSetting {
  dietitianId String
  dietitian   User     @relation(fields: [dietitianId], references: [id], onDelete: Cascade)
  ruleId      String
  enabled     Boolean  @default(true)
  threshold   Float?
  updatedAt   DateTime @updatedAt

  @@id([dietitianId, ruleId])
  @@map("alert_rule_settings")
}

// Latest computed adherence score + triggered alerts per active link. Rebuilt
// nightly and whenever the dietitian opens the client; the roster reads it.
model ClientInsight {
  linkId     String              @id
  link       DietitianClientLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  score      Int?
  scoreParts Json
  alerts     Json
  computedAt DateTime

  @@map("client_insights")
}

// admin module: one row per LLM call, attributed to the requesting user when
// the call ran inside a request (userId null for background work). Written in
// batches by BufferedAiUsageRecorder; no FK so a deleted user's usage stays
// countable in totals.
model AiUsageEvent {
  id           String   @id @default(uuid())
  userId       String?
  feature      String
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_events")
}

// admin module: every state-changing platform-admin action.
model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String // e.g. 'user.suspend', 'premium.grant', 'code.create'
  targetType String // 'user' | 'dietitian' | 'activation_code' | 'client_link'
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetId])
  @@map("admin_audit_logs")
}

// practice module: a dietitian's AI assistant — the AI coach speaking to their
// clients in the dietitian's voice. Persona + rules are prompt context, not a fine-tune.
model DietitianAiSettings {
  dietitianId          String   @id
  dietitian            User     @relation(fields: [dietitianId], references: [id], onDelete: Cascade)
  // Master switch. Off → none of the dietitian's clients get the AI.
  enabled              Boolean  @default(false)
  // Clients without their own override get this.
  defaultClientAccess  Boolean  @default(true)
  assistantName        String?
  addressForm          String? // 'sen' | 'siz'
  tone                 String?
  approach             String?
  rules                String[] @default([])
  avoid                String[] @default([])
  handoffMessage       String?
  // null → always on; else { timeZone, windows: [{ days: number[], start: "HH:MM", end: "HH:MM" }] }
  schedule             Json?
  updatedAt            DateTime @updatedAt

  @@map("dietitian_ai_settings")
}

// A question/answer pair showing the AI how the dietitian answers. 'correction'
// = the dietitian rewrote a real AI reply while reviewing a client's chat.
model DietitianAiExample {
  id              String   @id @default(uuid())
  dietitianId     String
  dietitian       User     @relation(fields: [dietitianId], references: [id], onDelete: Cascade)
  question        String
  answer          String
  source          String   @default("manual") // 'manual' | 'correction'
  sourceMessageId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dietitianId, createdAt])
  @@index([sourceMessageId])
  @@map("dietitian_ai_examples")
}

// Per-client AI override + private instructions. Kept off DietitianClientLink so
// it can never leak into the link payload the client reads.
model ClientAiSetting {
  linkId       String              @id
  link         DietitianClientLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  access       String? // 'on' | 'off' | null (dietitian default)
  instructions String?
  updatedAt    DateTime            @updatedAt

  @@map("client_ai_settings")
}
