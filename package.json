{
  "name": "eatbetter-backend",
  "version": "0.1.0",
  "private": true,
  "description": "betterEatBetter — food tracking app backend (Node.js/TypeScript, modular monolith + Ports & Adapters)",
  "main": "dist/main.js",
  "prisma": {
    "schema": "src/shared/persistence/schema.prisma"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --testPathIgnorePatterns=\\.integration\\.test\\.ts$ --testPathIgnorePatterns=\\.e2e\\.test\\.ts$",
    "test:integration": "jest --testPathPattern=\\.integration\\.test\\.ts$",
    "test:e2e": "jest --testPathPattern=\\.e2e\\.test\\.ts$",
    "test:http": "jest --runInBand --testPathPattern=test/http/.*\\.smoke\\.test\\.ts$",
    "test:http:local": "node scripts/run-http-smoke-tests.cjs",
    "db:create:smoke": "node scripts/create-smoke-db.cjs",
    "test:all": "jest",
    "import:usda": "ts-node src/modules/food-recognition/adapters/search/importUsdaData.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@bull-board/api": "^5.21.0",
    "@bull-board/express": "^5.21.0",
    "@prisma/client": "^5.15.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "argon2": "^0.40.3",
    "bullmq": "^5.7.0",
    "cockatiel": "^3.2.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^7.5.0",
    "pino": "^9.14.0",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.2",
    "sharp": "^0.35.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "prisma": "^5.15.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.9.0",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
