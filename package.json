{
  "name": "eatbetter-backend",
  "version": "0.1.0",
  "private": true,
  "description": "betterEatBetter — food tracking app backend (Node.js/TypeScript, modular monolith + Ports & Adapters)",
  "main": "dist/main.js",
  "prisma": {
    "schema": "src/shared/persistence/schema.prisma"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --testPathIgnorePatterns=\\.integration\\.test\\.ts$",
    "test:integration": "jest --testPathPattern=\\.integration\\.test\\.ts$",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@prisma/client": "^5.15.0",
    "bullmq": "^5.7.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.2.0",
    "prom-client": "^15.1.2",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "@bull-board/api": "^5.21.0",
    "@bull-board/express": "^5.21.0",
    "cockatiel": "^3.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "prisma": "^5.15.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.9.0",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
