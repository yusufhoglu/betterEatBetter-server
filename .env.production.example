# Copy to `.env` on the server and fill in. This single file is read by
# docker compose for both variable interpolation and the app container's env.
#
# NOTE: DATABASE_URL, REDIS_URL and REDIS_CACHE_URL are set by
# docker-compose.prod.yml to the internal service hostnames -- do not set them here.

# ---- infra / deploy ----
# Container image to run (the CI pipeline exports this; keep in sync if deploying by hand).
IMAGE=ghcr.io/yusufhoglu/bettereatbetter-server:latest
# Public domain for this API (A record -> server IP). TLS is handled by the
# host Caddy (matcher-prod-caddy), not this stack -- see DEPLOY.md.
DOMAIN=foodtracker.hembul.com
# Postgres superuser password for the bundled postgres container.
POSTGRES_PASSWORD=change-me-long-random

# ---- app ----
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=30

# identity module - Google Sign-In. Comma-separated OAuth client IDs
# (iOS / Android / Web) from Google Cloud Console > Credentials.
GOOGLE_OAUTH_CLIENT_IDS=

# Cloudflare R2 (S3-compatible object storage for meal photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=food-tracking-photos

# Python RAG service (photo recognition). Must be reachable from the container.
RAG_SERVICE_URL=http://rag:8000

# food-recognition module
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
MAX_PHOTO_SIZE_BYTES=10485760
PHOTO_WORKER_CONCURRENCY=2
TIMEOUTS_ENABLED=true
PHOTO_ESTIMATOR_TIMEOUT_MS=2400000
RATE_LIMIT_ENABLED=true

# LLM provider (openai | anthropic) -- only the selected provider's key is required.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=60000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
CHATBOT_MODEL=gpt-5-mini
FOOD_TEXT_MODEL=gpt-5-mini

# subscription module -- Google Play Developer API + RTDN
GOOGLE_PLAY_PACKAGE_NAME=com.bettereatbetter.better_eat_better
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_AUDIENCE=https://foodtracker.hembul.com/subscription/play-rtdn
APPLE_SHARED_SECRET=

# notifications/adapters/push
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=

# Observability (optional -- leave blank to disable Loki shipping)
LOG_LEVEL=info
LOKI_URL=
LOKI_USER_ID=
LOKI_API_TOKEN=
