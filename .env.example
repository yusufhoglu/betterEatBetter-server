NODE_ENV=development
PORT=3000

# shared/persistence/db.ts
DATABASE_URL=

# shared/queue/redisConnection.ts (BullMQ) — must stay separate from the cache instance
REDIS_URL=

# shared/cache/redisCacheClient.ts (ayri instance/db index — kuyruktan izole)
REDIS_CACHE_URL=

# shared/storage/objectStorageClient.ts (Cloudflare R2, S3-uyumlu)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# shared/auth — access token JWT secret; refresh token is an opaque DB-stored value (jwt.ts, refreshTokenService.ts)
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=30

# Python RAG servisi (food-recognition/adapters/photo)
RAG_SERVICE_URL=

# Observability
LOG_LEVEL=info
GRAFANA_CLOUD_TOKEN=
AXIOM_TOKEN=

# chatbot/adapters/llm
LLM_API_KEY=

# subscription/adapters/billing
APPLE_SHARED_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# notifications/adapters/push
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
