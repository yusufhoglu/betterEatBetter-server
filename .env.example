PORT=3000

# shared/persistence/db.ts
DATABASE_URL=

# shared/queue/redisConnection.ts (BullMQ) — must stay separate from the cache instance
REDIS_URL=

# shared/auth — access token JWT secret; refresh token is an opaque DB-stored value (jwt.ts, refreshTokenService.ts)
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=30

# Observability
LOG_LEVEL=info
