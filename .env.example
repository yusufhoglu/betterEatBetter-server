NODE_ENV=development
PORT=3000

# shared/persistence/db.ts
# Use 127.0.0.1 (not "localhost") — on Windows + Docker Desktop "localhost"
# resolves to IPv6 ::1 first and the Docker loopback proxy drops those
# connections intermittently (Prisma "Can't reach database server" / ioredis ECONNRESET).
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/food_tracking
SMOKE_TEST_DATABASE_URL=postgresql://app:app@127.0.0.1:5432/food_tracking_smoke
# Connection pool sizing — appended to DATABASE_URL when not already present.
# Default Prisma pool is only num_cpu*2+1; raise for concurrent request bursts.
DATABASE_CONNECTION_LIMIT=20
DATABASE_POOL_TIMEOUT_SECONDS=20

# shared/queue/redisConnection.ts (BullMQ) - must stay separate from the cache instance
REDIS_URL=redis://127.0.0.1:6379

# shared/cache/redisCacheClient.ts (separate instance from queue Redis)
REDIS_CACHE_URL=redis://127.0.0.1:6380

# shared/storage/objectStorageClient.ts (Cloudflare R2, S3-compatible)
# The current backend targets Cloudflare R2 directly, so these should be real
# R2 credentials even in local development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=food-tracking-photos

# shared/auth
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=30

# identity module - Google Sign-In (POST /auth/social with provider=google).
# Comma-separated OAuth client IDs, one per client platform (iOS / Android / Web),
# from Google Cloud Console > Credentials. Used as the accepted audience when
# verifying the ID token the mobile app sends.
GOOGLE_OAUTH_CLIENT_IDS=

# Python RAG service used by photo recognition.
# This service is not included in this repository.
RAG_SERVICE_URL=http://localhost:8000

# food-recognition module settings
LLM_SERVICE_URL=http://localhost:11434
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
MAX_PHOTO_SIZE_BYTES=10485760
PHOTO_WORKER_CONCURRENCY=2
TIMEOUTS_ENABLED=true
PHOTO_ESTIMATOR_TIMEOUT_MS=2400000
RATE_LIMIT_ENABLED=true

# Chat message rate limits (sliding 60s window). The global ceiling is split
# so free-tier load can't starve premium users.
CHAT_RATE_LIMIT_PER_USER=20
CHAT_RATE_LIMIT_GLOBAL_FREE=400
CHAT_RATE_LIMIT_GLOBAL_PREMIUM=2000
ENTITLEMENT_CACHE_TTL_SECONDS=60

# Observability
LOG_LEVEL=info
LOKI_URL=
LOKI_USER_ID=
LOKI_API_TOKEN=
GRAFANA_CLOUD_TOKEN=
AXIOM_TOKEN=

# shared/llm/llmClientFactory.ts
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=60000
# SDK-level retry budget (honours Retry-After on 429/5xx).
OPENAI_MAX_RETRIES=3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
CHATBOT_MODEL=gpt-5-mini
FOOD_TEXT_MODEL=gpt-5-mini
# Global ceiling on concurrent outbound LLM requests (all features share it).
# Excess callers queue up to LLM_MAX_QUEUE_DEPTH, then get LLM_OVERLOADED (503).
# Premium requests may use LLM_PREMIUM_BURST_SLOTS extra slots and jump the
# queue ahead of free traffic. Size to your provider tier's RPM/TPM.
LLM_MAX_CONCURRENCY=24
LLM_PREMIUM_BURST_SLOTS=4
LLM_MAX_QUEUE_DEPTH=200

# subscription/adapters/billing
APPLE_SHARED_SECRET=
# Google Play Console > Setup > API access — service account JSON key with
# "View financial data" access, granted the androidpublisher scope.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Android package name, see subscription-backend-contract.md
GOOGLE_PLAY_PACKAGE_NAME=com.bettereatbetter.better_eat_better
# Public URL of this server's RTDN push endpoint (Play Console > Monetization
# setup > Real-time developer notifications, wired to a Cloud Pub/Sub push
# subscription whose push endpoint audience matches this value).
GOOGLE_PLAY_RTDN_AUDIENCE=https://api.example.com/subscription/play-rtdn

# notifications module
# Master switch for push delivery + the scheduled reminder/streak/weekly jobs.
# When true, the FCM + APNS_* credential vars below are all required at boot.
NOTIFICATIONS_ENABLED=false
# Streak-saver nudge fires at this local hour (0-23) if the day isn't complete.
STREAK_SAVER_LOCAL_HOUR=21
# Weekly report: local weekday (0=Sun..6=Sat) + local hour it fires.
WEEKLY_REPORT_WEEKDAY=1
WEEKLY_REPORT_LOCAL_HOUR=9

# notifications/adapters/push
# FCM HTTP v1 service account JSON (Firebase console > Project settings >
# Service accounts). FCM_PROJECT_ID defaults to the JSON's project_id.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
# APNs token-based auth (Apple Developer > Keys, an "Apple Push Notifications
# service" key). APNS_AUTH_KEY is the .p8 file's PEM contents (newlines as \n).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=
APNS_BUNDLE_ID=com.bettereatbetter.better_eat_better
APNS_ENVIRONMENT=sandbox
